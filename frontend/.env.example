# Supabase Community Project (auth, members, posts, teams, welfare projects, blogs — consolidated)
# Both must ALSO be set in the Vercel project environment (Production +
# Preview), not only locally.
VITE_SUPABASE_URL=https://your-community-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-community-anon-key

# Paradox event sub-app (paradox_* tables) — a separate Supabase project.
# Optional: if unset, paradox/lib/supabase.ts falls back to the community
# project's URL/anon key above.
VITE_PARADOX_SUPABASE_URL=https://your-paradox-project.supabase.co
VITE_PARADOX_SUPABASE_ANON_KEY=your-paradox-anon-key

# scripts/compute-org-facts.mjs ONLY — never read by the shipped app (no VITE_
# prefix, so Vite never bundles it into client code). Bypasses RLS, so this is
# a SERVER-SIDE / CI secret: set it in the Vercel project's Production +
# Preview environment variables, never in a client-readable place. Get it from
# Supabase Dashboard → Project Settings → API → service_role key.
# Missing this is NOT a build error — compute-org-facts.mjs warns and leaves
# the committed frontend/src/lib/orgFacts.ts exactly as it is (see that
# script's header for why a missing secret fails soft while a broken query
# fails the build).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
