{
  "name": "aquaterra-community-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/lint-accent-tokens.mjs && node scripts/verify-routing.mjs && node scripts/compute-org-facts.mjs && node scripts/generate-sitemap.mjs && tsc -b && vite build && node scripts/verify-sitemap.mjs && node scripts/check-bundle-budget.mjs && node scripts/prerender-meta.mjs",
    "build:full": "npm run build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "org-facts": "node scripts/compute-org-facts.mjs",
    "start": "node server.cjs",
    "lint": "eslint . && node scripts/lint-accent-tokens.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "lint:accent": "node scripts/lint-accent-tokens.mjs",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "jsbarcode": "^3.12.3",
    "obscenity": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
